PORT=3100
BEES_ACCOUNT_API_URL=https://directory.example.com
BEES_HOSTED_CLIENT_URL=https://client.example.com
BEES_GATEWAY_STATE=/var/lib/bees-gateway
BEES_CLIENT_ASSETS=/opt/bees-client/dist/hosted
# Replace with the reviewed digest of your own image.
BEES_CLIENT_IMAGE=registry.example.com/bees-client@sha256:REPLACE_WITH_IMAGE_DIGEST
BEES_MAX_HOSTED_CLIENTS=50
BEES_HOSTED_RUNS_PER_DAY=1
# Set BEES_HOSTED_MODEL and BEES_MODEL_PROFILE privately in the service environment.
# BEES_MODEL_PROFILE is a DSH provider profile, with provider ID `hosted`.
# Never store provider credentials in a browser bundle or this repository.
