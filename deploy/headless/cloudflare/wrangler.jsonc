{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bees-stage1-proof",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  "containers": [{
    "class_name": "BeesProof",
    "image": "../Dockerfile",
    "image_build_context": "../../..",
    "instance_type": "standard-2",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "PROOF", "class_name": "BeesProof" }] },
  "exports": { "BeesProof": { "type": "durable-object", "storage": "sqlite" } }
}
