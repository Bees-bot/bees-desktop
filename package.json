{
  "name": "@bees/desktop",
  "private": true,
  "version": "0.2.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --omit=dev --prefix dsh-runtime --ignore-scripts && node scripts/stage-dsh-plugin.mjs",
    "prepare:dsh": "node scripts/stage-dsh-plugin.mjs && node scripts/prepare-dsh-runtime.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/dsh-*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "tauri:dev": "npm run build && npm run prepare:dsh && tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": { "@tauri-apps/api": "2.11.1" },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.11",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.0"
  }
}
