  "type": "module",
  "scripts": {
    "postinstall": "npm ci --omit=dev --prefix flue-runtime",
    "prepare:flue": "node scripts/prepare-flue-runtime.mjs",
    "dev": "vite",
    "build": "vite build && npm run build:flue",
