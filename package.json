{
  "name": "@bees/desktop",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0 <25.0.0"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --omit=dev --prefix dsh-runtime --ignore-scripts --legacy-peer-deps && node scripts/install-dsh-runtime.mjs && npm rebuild --prefix dsh-runtime better-sqlite3 && node scripts/stage-dsh-plugin.mjs",
    "prepare:dsh": "node scripts/install-dsh-runtime.mjs && node scripts/stage-dsh-plugin.mjs && node scripts/prepare-dsh-runtime.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:dsh-client": "node scripts/build-dsh-client.mjs",
    "release:prepare": "node scripts/release.mjs version",
    "test:release": "node --test tests/release.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:dsh-client && vitest run tests/dsh-*.test.ts",
    "check": "npm run test:release && npm run typecheck && npm test && npm run build",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:prod": "BEES_ACCOUNT_API_URL=https://app.bees.bot tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@shikijs/langs": "4.4.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.11",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "esbuild": "0.28.0",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "shiki": "4.4.3",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  }
}
