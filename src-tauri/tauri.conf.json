{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bees",
  "version": "0.2.0",
  "identifier": "bot.bees.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Bees",
      "width": 1180,
      "height": 760,
      "minWidth": 820,
      "minHeight": 560
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bees-node", "binaries/temporal"],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../dsh-runtime": "dsh-runtime",
      "../llama-runtime": "llama-runtime",
      "../NOTICE": "licenses/NOTICE",
      "../LICENSE": "licenses/LICENSE",
      "../LICENSE-APACHE": "licenses/LICENSE-APACHE",
      "../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../LICENSE-LGPL-3.0": "licenses/LICENSE-LGPL-3.0",
      "../LICENSE-GPL-3.0": "licenses/LICENSE-GPL-3.0"
    }
  }
}
