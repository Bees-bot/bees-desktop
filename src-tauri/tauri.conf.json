{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bees",
  "version": "0.2.0",
  "identifier": "bot.bees.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run prepare:dsh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Bees",
      "width": 1180,
      "height": 760,
      "minWidth": 820,
      "minHeight": 560
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bees-node"],
    "resources": { "../dsh-runtime": "dsh-runtime" }
  }
}
