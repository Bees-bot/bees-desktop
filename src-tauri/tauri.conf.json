{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bees",
  "version": "0.1.1",
  "identifier": "bot.bees.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run prepare:flue && npm run prepare:bridge",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bees",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://127.0.0.1:* http://localhost:3000 https://app.bees.bot; worker-src 'self' blob:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bees"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Bees-bot/bees-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNDBBMzQwNkNEN0UzQzAKUldUQTQ5ZHNRS05Bd2pjZXVuWkttV2xwSEh0QmZIQURER29udjFmZjdYSG9BRUR0ZkRpRm5PSTEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "externalBin": [
      "binaries/bees-node",
      "binaries/temporal"
    ],
    "resources": {
      "../flue-runtime/default-registry": "flue-runtime/default-registry",
      "../flue-runtime/node_modules": "flue-runtime/node_modules",
      "../flue-runtime/project/dist": "flue-runtime/project/dist",
      "../flue-runtime/project/capability-server.mjs": "flue-runtime/project/capability-server.mjs",
      "../flue-runtime/project/parent-lifecycle.mjs": "flue-runtime/project/parent-lifecycle.mjs",
      "../flue-runtime/project/start.mjs": "flue-runtime/project/start.mjs",
      "../flue-runtime/project/workflow": "flue-runtime/project/workflow",
      "../llama-runtime": "llama-runtime",
      "../services/knowledge-worker/bees_knowledge_worker": "knowledge-worker/bees_knowledge_worker",
      "../services/api-bridge/bridge.mjs": "api-bridge/bridge.mjs"
    }
  }
}
