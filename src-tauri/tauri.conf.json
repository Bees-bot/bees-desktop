{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bees Client",
  "version": "0.30.0",
  "identifier": "bot.bees.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [{
      "title": "Bees Client",
      "dragDropEnabled": false,
      "width": 1180,
      "height": 760,
      "maximized": true,
      "minWidth": 820,
      "minHeight": 560,
      "transparent": true,
      "titleBarStyle": "Overlay",
      "windowEffects": { "effects": ["windowBackground", "mica"] }
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bees-node"],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../dsh-runtime": "dsh-runtime",
      "../NOTICE": "licenses/NOTICE",
      "../LICENSE-APACHE": "licenses/LICENSE-APACHE",
      "../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../licenses/LICENSE-LGPL-3.0": "licenses/LICENSE-LGPL-3.0",
      "../licenses/LICENSE-GPL-3.0": "licenses/LICENSE-GPL-3.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzODc5NkQwMzlEMUFFMEEKUldRS3J0RTUwSmFIQTJkdnpocnd6aXlQc1FUY0taUWVkL245a3pDb3ZWTVJnWFc5UTdjNUFTY2QK",
      "endpoints": ["https://github.com/Bees-bot/bees-desktop/releases/latest/download/bees-update.json"],
      "requireSignedVersion": true
    }
  }
}
