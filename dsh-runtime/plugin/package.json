{
  "name": "@bees/dsh-plugin",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@bees/dsh-local-ai",
        "@bees/dsh-free-ai",
        "@bees/dsh-custom-ai",
        "@bees/dsh-subscriptions",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "external": [
        "@bees/dsh-local-ai",
        "@bees/dsh-free-ai",
        "@bees/dsh-custom-ai",
        "@bees/dsh-subscriptions"
      ]
    }
  },
  "peerDependencies": {
    "@bees/dsh-custom-ai": "0.1.0",
    "@bees/dsh-free-ai": "0.1.0",
    "@bees/dsh-local-ai": "0.1.0",
    "@bees/dsh-subscriptions": "0.1.0",
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "files": [
    "lib"
  ]
}
