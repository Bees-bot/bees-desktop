{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The .flue project (reached from tests) imports with explicit .ts extensions, which is
    // what the Flue runtime itself resolves.
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ]
}

